{
  "expo": {
    "name": "Mendyr",
    "slug": "mendyr-mobile",
    "version": "1.1.0",
    "cli": {
      "appVersionSource": "remote"
    },
    "orientation": "portrait",
    "icon": "./assets/branding/mendyr.png",
    "scheme": "mendyr",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/mendyr.png",
      "resizeMode": "contain",
      "backgroundColor": "#1262E2"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF5FE",
        "foregroundImage": "./assets/branding/mendyr.png"
      },
      "splash": {
        "backgroundColor": "#1262E2",
        "image": "./assets/branding/mendyr.png",
        "resizeMode": "contain"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.taindua.mendyrmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1262E2",
          "image": "./assets/branding/mendyr.png",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mendyr to use your location to find care near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d4e64e5-1e50-46b0-b74f-9bc15c4001bb"
      }
    },
    "owner": "kartikss-team"
  }
}
